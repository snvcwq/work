@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="shell">
    <NavMenu />
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    an unhandled error has occurred.
    <a href="." class="reload">reload</a>
    <span class="dismiss">&times;</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    // Blazor Server routes within the same circuit (no full page reload), so the
    // data-page attribute + favicon set by App.razor's inline script at first paint
    // need to be re-applied after every later in-app navigation too.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await JS.InvokeVoidAsync("dashboardApplyPage");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
