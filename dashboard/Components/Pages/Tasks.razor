@page "/"
@page "/tasks"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject dashboard.Data.MongoContext Db
@inject IJSRuntime JS
@using dashboard.Models
@using MongoDB.Driver

<PageTitle>dashboard</PageTitle>

<div class="page page-tasks">
    <div class="page-header">
        <div class="page-heading">
            <span class="page-icon page-icon-tasks">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                </svg>
            </span>
            <div>
                <h1>tasks</h1>
                <p class="page-subtitle">
                    @(FilteredTasks.Count) tracked
                    @if (IsFiltering && tasks is not null)
                    {
                        <text> of @tasks.Count</text>
                    }
                    <text> &middot; drag to reprioritize</text>
                </p>
            </div>
        </div>
        <button class="btn-primary" @onclick="ToggleAddForm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            add task
        </button>
    </div>

    @if (tasks is not null && tasks.Count > 0)
    {
        <div class="filter-bar">
            <input class="search-input" type="search" placeholder="search by number or title…" @bind="searchText" @bind:event="oninput" />
            <StatusFilterDropdown TStatus="WorkStatus" @bind-Value="statusFilter" Format="FormatStatus" AllLabel="all statuses" Options="WorkStatusOrder" />
            @if (IsFiltering)
            {
                <button class="btn-ghost" @onclick="ClearFilters">clear</button>
            }
        </div>
    }

    @if (showAddForm)
    {
        <div class="add-form">
            <WorkItemTypeDropdown @bind-Value="newType" />
            <input class="input-number" @bind="newNumber" placeholder="number" />
            <input class="input-url" @bind="newUrl" placeholder="url" />
            <input class="input-title" @bind="newTitle" placeholder="title" />
            <button class="btn-primary" @onclick="AddTask">add</button>
            <button class="btn-ghost" @onclick="ToggleAddForm">cancel</button>
        </div>
    }

    @if (connectionError)
    {
        <div class="empty-state error-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 9v4" /><path d="M12 17h.01" />
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            </svg>
            <span>can't reach mongodb — is docker running? try <code>docker compose up -d</code> in dashboard/</span>
        </div>
    }
    else if (tasks is null)
    {
        <p class="muted">loading…</p>
    }
    else if (tasks.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4" />
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
            </svg>
            <span>no tasks yet — ask claude to pull some from azure devops, or add one above.</span>
        </div>
    }
    else if (FilteredTasks.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4" />
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
            </svg>
            <span>no tasks match this filter.</span>
        </div>
    }
    else
    {
        <div class="task-list">
            @foreach (var task in FilteredTasks)
            {
                <div class="task-row" @key="task.Id" data-task-id="@task.Id">
                    <span class="drag-handle">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <circle cx="9" cy="6" r="1.3" /><circle cx="9" cy="12" r="1.3" /><circle cx="9" cy="18" r="1.3" />
                            <circle cx="15" cy="6" r="1.3" /><circle cx="15" cy="12" r="1.3" /><circle cx="15" cy="18" r="1.3" />
                        </svg>
                    </span>
                    <WorkItemTypeDropdown Value="task.Type" ReadOnly="true" />
                    <a class="task-number" href="@task.Url" target="_blank" rel="noopener">#@task.Number</a>
                    <a class="task-title" href="@($"/tasks/{task.Id}")">@task.Title</a>
                    @if (PrCount(task.Id) > 0)
                    {
                        <a class="pr-count" href="@($"/prs?taskId={task.Id}")">@PrCount(task.Id) pr@(PrCount(task.Id) == 1 ? "" : "s")</a>
                    }
                    else
                    {
                        <span class="pr-count">0 prs</span>
                    }
                    @if (task.Stage is not null)
                    {
                        <span class="stage-chip @(task.Stage == PipelineStage.BlockedOnHuman ? "stage-chip-blocked" : "")" title="@(task.StageDetail ?? FormatStage(task.Stage.Value))">
                            @FormatStage(task.Stage.Value)
                        </span>
                    }
                    <StatusDropdown TStatus="WorkStatus" @bind-Value="task.Status" @bind-Value:after="() => UpdateStatus(task)" Format="FormatStatus" Options="WorkStatusOrder" />
                    <button class="btn-icon" title="delete" @onclick="() => DeleteTask(task.Id)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18" />
                            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<WorkTask>? tasks;
    private List<PullRequest> prs = new();
    private bool dragInProgress;
    private bool showAddForm;
    private bool connectionError;
    private string newNumber = "";
    private string newUrl = "";
    private string newTitle = "";
    private WorkItemType newType = WorkItemType.Undefined;
    private string searchText = "";
    private Timer? refreshTimer;
    private IJSObjectReference? module;
    private DotNetObjectReference<Tasks>? objRef;

    private WorkStatus? statusFilter;

    private bool IsFiltering => !string.IsNullOrWhiteSpace(searchText) || statusFilter is not null;

    private List<WorkTask> FilteredTasks =>
        (tasks ?? new())
            .Where(t => statusFilter is null || t.Status == statusFilter)
            .Where(t => string.IsNullOrWhiteSpace(searchText)
                || t.Number.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || t.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private void ClearFilters()
    {
        searchText = "";
        statusFilter = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        refreshTimer = new Timer(async _ => await InvokeAsync(async () =>
        {
            if (!dragInProgress)
            {
                await Load();
                StateHasChanged();
            }
        }), null, 4000, 4000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Tasks.razor.js");
        }

        // Cheap no-ops once attached; retried every render since the list (and the
        // pointer/mutation listeners' target) doesn't exist in the DOM until tasks load.
        if (module is not null)
        {
            await module.InvokeVoidAsync("initSortable", objRef);
            await module.InvokeVoidAsync("initFlipObserver");
        }
    }

    private async Task Load()
    {
        try
        {
            tasks = await Db.GetAllTasksAsync();
            prs = await Db.GetAllPrsAsync();
            connectionError = false;
        }
        catch (MongoException)
        {
            connectionError = true;
        }
    }

    private int PrCount(string taskId) => prs.Count(p => p.TaskId == taskId);

    private static string FormatStatus(WorkStatus s) => s switch
    {
        WorkStatus.Undefined => "undefined",
        WorkStatus.New => "new",
        WorkStatus.Active => "active",
        WorkStatus.Blocker => "blocker",
        WorkStatus.PrWaitingForReview => "pr waiting for review",
        WorkStatus.PrApproved => "pr approved",
        WorkStatus.PrMerged => "pr merged",
        WorkStatus.WaitingForRelease => "waiting for release",
        WorkStatus.Released => "released",
        WorkStatus.Resolved => "resolved",
        WorkStatus.Done => "done",
        WorkStatus.Removed => "removed",
        _ => s.ToString()
    };

    // PrApproved/PrMerged/Released/Active were appended to the enum (to keep existing stored
    // statuses' int values stable) but read better slotted into the natural pr → release
    // lifecycle here.
    private static readonly WorkStatus[] WorkStatusOrder =
    [
        WorkStatus.Undefined,
        WorkStatus.New,
        WorkStatus.Active,
        WorkStatus.Blocker,
        WorkStatus.PrWaitingForReview,
        WorkStatus.PrApproved,
        WorkStatus.PrMerged,
        WorkStatus.WaitingForRelease,
        WorkStatus.Released,
        WorkStatus.Resolved,
        WorkStatus.Done,
        WorkStatus.Removed
    ];

    private static string FormatStage(PipelineStage s) => s switch
    {
        PipelineStage.Queued => "queued",
        PipelineStage.SyncingToAzure => "syncing to azure",
        PipelineStage.Coding => "coding",
        PipelineStage.CodeReview => "code review",
        PipelineStage.Testing => "testing",
        PipelineStage.PushingBranch => "pushing branch",
        PipelineStage.AwaitingPrReview => "awaiting pr review",
        PipelineStage.FixingReviewComments => "fixing review comments",
        PipelineStage.Merging => "merging",
        PipelineStage.Closing => "closing",
        PipelineStage.BlockedOnHuman => "blocked on you",
        _ => s.ToString()
    };

    private void ToggleAddForm() => showAddForm = !showAddForm;

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        await Db.CreateTaskAsync(new WorkTask
        {
            Number = newNumber,
            Url = newUrl,
            Title = newTitle,
            Status = WorkStatus.Undefined,
            Type = newType
        });

        newNumber = "";
        newUrl = "";
        newTitle = "";
        newType = WorkItemType.Undefined;
        showAddForm = false;
        await Load();
    }

    private async Task UpdateStatus(WorkTask task) => await Db.SetTaskStatusAsync(task.Id, task.Status);

    private async Task DeleteTask(string id)
    {
        await Db.DeleteTaskCascadeAsync(id);
        await Load();
    }

    // The drag itself — following the pointer, live swapping — happens entirely client-side
    // in Tasks.razor.js; these two calls are its only touchpoints with the server.
    [JSInvokable]
    public void NotifyDragStart() => dragInProgress = true;

    [JSInvokable]
    public async Task CommitReorder(string[] orderedIds)
    {
        if (tasks is null)
        {
            dragInProgress = false;
            return;
        }

        // orderedIds only covers whatever was rendered — the full list when unfiltered, or
        // just the matching subset when a search/status filter is active. Splicing the new
        // subset order back into the *slots* that subset already occupied (instead of
        // replacing the whole list with it) keeps filtered-out tasks exactly where they were
        // rather than losing them or collapsing the list down to only what was visible.
        var byId = tasks.ToDictionary(t => t.Id);
        var reordered = new HashSet<string>(orderedIds);
        var queue = new Queue<string>(orderedIds.Where(byId.ContainsKey));
        tasks = tasks.Select(t => reordered.Contains(t.Id) && queue.Count > 0 ? byId[queue.Dequeue()] : t).ToList();
        StateHasChanged();

        try
        {
            // dragInProgress stays true across the whole persist, not just the drag gesture —
            // ReorderTasksAsync writes priorities one at a time (not a single atomic batch), and
            // the periodic refresh timer ignores that guard the moment it flips back to false.
            // Clearing it before the writes land lets a timer tick land mid-write, read a
            // partially-updated priority order back out of Mongo, and stomp the correct
            // client-side order with it.
            await Db.ReorderTasksAsync(tasks.Select(t => t.Id).ToList());
        }
        finally
        {
            dragInProgress = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        refreshTimer?.Dispose();
        objRef?.Dispose();
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit already gone — nothing to clean up client-side
            }
        }
    }
}
