@page "/tasks/{Id}"
@rendermode InteractiveServer
@implements IDisposable
@inject dashboard.Data.MongoContext Db
@using dashboard.Models
@using MongoDB.Driver

<PageTitle>dashboard</PageTitle>

<div class="page page-task-detail">
    <a class="back-link" href="/">&larr; back to tasks</a>

    @if (connectionError)
    {
        <div class="empty-state error-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 9v4" /><path d="M12 17h.01" />
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            </svg>
            <span>can't reach mongodb — is docker running? try <code>docker compose up -d</code> in dashboard/</span>
        </div>
    }
    else if (!loaded)
    {
        <p class="muted">loading…</p>
    }
    else if (task is null)
    {
        <div class="empty-state">
            <span>task not found — it may have been deleted.</span>
        </div>
    }
    else
    {
        <div class="detail-header">
            <WorkItemTypeDropdown Value="task.Type" ReadOnly="true" />
            <div class="detail-heading">
                <h1><a class="task-number" href="@task.Url" target="_blank" rel="noopener">#@task.Number</a> @task.Title</h1>
                <p class="page-subtitle">
                    created @task.CreatedAt.ToLocalTime().ToString("MMM d")
                    &middot; updated @RelativeTime(task.UpdatedAt)
                    @if (!string.IsNullOrWhiteSpace(task.Assignee))
                    {
                        <text> &middot; assigned to @task.Assignee</text>
                    }
                </p>
            </div>
            <StatusDropdown TStatus="WorkStatus" @bind-Value="task.Status" @bind-Value:after="UpdateStatus" Format="FormatStatus" Options="WorkStatusOrder" />
        </div>

        @if (task.Stage is not null)
        {
            <div class="stage-banner @(task.Stage == PipelineStage.BlockedOnHuman ? "stage-banner-blocked" : "")">
                <span class="stage-chip @(task.Stage == PipelineStage.BlockedOnHuman ? "stage-chip-blocked" : "")">@FormatStage(task.Stage.Value)</span>
                @if (!string.IsNullOrWhiteSpace(task.StageDetail))
                {
                    <span class="stage-banner-detail">@task.StageDetail</span>
                }
            </div>
        }

        @if (prs.Count > 0)
        {
            <section class="detail-section">
                <h2>linked prs</h2>
                <div class="detail-pr-list">
                    @foreach (var pr in prs)
                    {
                        <div class="detail-pr-row" @key="pr.Id">
                            <a class="pr-number" href="@pr.Url" target="_blank" rel="noopener">#@pr.Number</a>
                            <span class="pr-title">@pr.Title</span>
                            <span class="status-pill status-@pr.Status.ToString().ToLowerInvariant()">
                                <span class="status-pill-dot"></span>
                                <span class="status-pill-label">@FormatPrStatus(pr.Status)</span>
                            </span>
                        </div>
                    }
                </div>
            </section>
        }

        <section class="detail-section">
            <h2>timeline</h2>
            <div class="add-comment">
                <input class="add-comment-input" placeholder="add a note…" @bind="newComment" @bind:event="oninput" @onkeydown="OnCommentKeyDown" />
                <button class="btn-primary" @onclick="AddComment">add</button>
            </div>

            @if (events.Count == 0)
            {
                <p class="muted">nothing logged yet.</p>
            }
            else
            {
                <div class="event-list">
                    @foreach (var evt in events)
                    {
                        <div class="event-row" @key="evt.Id">
                            <span class="event-badge event-@(evt.Type.ToString().ToLowerInvariant())">
                                <span class="status-pill-dot"></span>
                                @FormatEventType(evt.Type)
                            </span>
                            <div class="event-body">
                                <span class="event-summary">@evt.Summary</span>
                                @if (evt.Context.Count > 0)
                                {
                                    <div class="event-context">
                                        @foreach (var kv in evt.Context)
                                        {
                                            <span class="event-context-chip"><b>@kv.Key:</b> @Truncate(kv.Value)</span>
                                        }
                                    </div>
                                }
                            </div>
                            <span class="event-time" title="@evt.CreatedAt.ToLocalTime().ToString("f")">@RelativeTime(evt.CreatedAt)</span>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private WorkTask? task;
    private List<PullRequest> prs = new();
    private List<DashboardEvent> events = new();
    private bool loaded;
    private bool connectionError;
    private Timer? refreshTimer;
    private string newComment = "";

    protected override async Task OnInitializedAsync()
    {
        await Load();
        refreshTimer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        }), null, 4000, 4000);
    }

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        try
        {
            task = await Db.FindTaskAsync(Id);
            if (task is not null)
            {
                prs = await Db.GetPrsForTaskAsync(Id);
                events = await Db.GetEventsForTaskAsync(Id);
            }
            connectionError = false;
        }
        catch (MongoException)
        {
            connectionError = true;
        }
        finally
        {
            loaded = true;
        }
    }

    private async Task UpdateStatus()
    {
        if (task is not null) await Db.SetTaskStatusAsync(task.Id, task.Status);
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(newComment) || task is null) return;
        await Db.AddTaskCommentAsync(task.Id, "you", newComment.Trim());
        newComment = "";
        await Load();
    }

    private async Task OnCommentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddComment();
    }

    private static string FormatStatus(WorkStatus s) => s switch
    {
        WorkStatus.Undefined => "undefined",
        WorkStatus.New => "new",
        WorkStatus.Active => "active",
        WorkStatus.Blocker => "blocker",
        WorkStatus.PrWaitingForReview => "pr waiting for review",
        WorkStatus.PrApproved => "pr approved",
        WorkStatus.PrMerged => "pr merged",
        WorkStatus.WaitingForRelease => "waiting for release",
        WorkStatus.Released => "released",
        WorkStatus.Resolved => "resolved",
        WorkStatus.Done => "done",
        WorkStatus.Removed => "removed",
        _ => s.ToString()
    };

    private static readonly WorkStatus[] WorkStatusOrder =
    [
        WorkStatus.Undefined,
        WorkStatus.New,
        WorkStatus.Active,
        WorkStatus.Blocker,
        WorkStatus.PrWaitingForReview,
        WorkStatus.PrApproved,
        WorkStatus.PrMerged,
        WorkStatus.WaitingForRelease,
        WorkStatus.Released,
        WorkStatus.Resolved,
        WorkStatus.Done,
        WorkStatus.Removed
    ];

    private static string FormatPrStatus(PrStatus s) => s switch
    {
        PrStatus.WaitingForReview => "waiting for review",
        PrStatus.Approved => "approved",
        PrStatus.NeedsChanges => "needs changes",
        PrStatus.Completed => "completed",
        _ => s.ToString()
    };

    private static string FormatStage(PipelineStage s) => s switch
    {
        PipelineStage.Queued => "queued",
        PipelineStage.SyncingToAzure => "syncing to azure",
        PipelineStage.Coding => "coding",
        PipelineStage.CodeReview => "code review",
        PipelineStage.Testing => "testing",
        PipelineStage.PushingBranch => "pushing branch",
        PipelineStage.AwaitingPrReview => "awaiting pr review",
        PipelineStage.FixingReviewComments => "fixing review comments",
        PipelineStage.Merging => "merging",
        PipelineStage.Closing => "closing",
        PipelineStage.BlockedOnHuman => "blocked on you",
        _ => s.ToString()
    };

    private static string FormatEventType(EventType t) => t switch
    {
        EventType.TaskCreated => "task created",
        EventType.TaskUpdated => "task updated",
        EventType.TaskAssigned => "task assigned",
        EventType.TaskReassigned => "task reassigned",
        EventType.TaskCommentAdded => "task comment",
        EventType.PrCreated => "pr created",
        EventType.PrUpdated => "pr updated",
        EventType.PrCommentAdded => "pr comment",
        EventType.PrApproved => "pr approved",
        EventType.TaskStageChanged => "stage changed",
        _ => t.ToString()
    };

    private static string Truncate(string s, int max = 160) =>
        s.Length <= max ? s : s[..max] + "…";

    private static string RelativeTime(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d");
    }

    public void Dispose() => refreshTimer?.Dispose();
}
