@page "/live"
@rendermode InteractiveServer
@implements IDisposable
@inject dashboard.Data.MongoContext Db
@using dashboard.Models
@using MongoDB.Driver

<PageTitle>dashboard</PageTitle>

<div class="page page-live">
    <div class="page-header">
        <div class="page-heading">
            <span class="page-icon page-icon-live">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12h4l2-7 4 14 2-7h6" />
                </svg>
            </span>
            <div>
                <h1><span class="live-pulse-dot" aria-hidden="true"></span>live</h1>
                <p class="page-subtitle">what's happening right now</p>
            </div>
        </div>
    </div>

    @if (connectionError)
    {
        <div class="empty-state error-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 9v4" /><path d="M12 17h.01" />
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
            </svg>
            <span>can't reach mongodb — is docker running? try <code>docker compose up -d</code> in dashboard/</span>
        </div>
    }
    else if (tasks is null)
    {
        <p class="muted">loading…</p>
    }
    else
    {
        <div class="live-stats">
            <div class="live-stat">
                <span class="live-stat-value">@InProgress.Count</span>
                <span class="live-stat-label">in progress</span>
            </div>
            <div class="live-stat @(Blocked.Count > 0 ? "live-stat-alert" : "")">
                <span class="live-stat-value">@Blocked.Count</span>
                <span class="live-stat-label">blocked on you</span>
            </div>
            <div class="live-stat">
                <span class="live-stat-value">@todayActivityCount</span>
                <span class="live-stat-label">actions today</span>
            </div>
        </div>

        @if (Blocked.Count > 0)
        {
            <section class="detail-section">
                <h2>blocked on you</h2>
                <div class="live-card-list">
                    @foreach (var t in Blocked)
                    {
                        <a class="live-card live-card-blocked" href="@($"/tasks/{t.Id}")" @key="t.Id">
                            <span class="stage-chip stage-chip-blocked">blocked on you</span>
                            <div class="live-card-body">
                                <span class="live-card-title">#@t.Number @t.Title</span>
                                @if (!string.IsNullOrWhiteSpace(t.StageDetail))
                                {
                                    <span class="live-card-detail">@t.StageDetail</span>
                                }
                            </div>
                            <span class="live-card-time">@RelativeTime(t.UpdatedAt)</span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="detail-section">
            <h2>in progress</h2>
            @if (InProgress.Count == 0)
            {
                <p class="muted">nothing in progress — the board is quiet.</p>
            }
            else
            {
                <div class="live-card-list">
                    @foreach (var t in InProgress)
                    {
                        <a class="live-card live-card-active" href="@($"/tasks/{t.Id}")" @key="t.Id">
                            <span class="stage-chip">@FormatStage(t.Stage!.Value)</span>
                            <div class="live-card-body">
                                <span class="live-card-title">#@t.Number @t.Title</span>
                                @if (!string.IsNullOrWhiteSpace(t.StageDetail))
                                {
                                    <span class="live-card-detail">@t.StageDetail</span>
                                }
                            </div>
                            <span class="live-card-time">@RelativeTime(t.UpdatedAt)</span>
                        </a>
                    }
                </div>
            }
        </section>

        <section class="detail-section">
            <div class="live-section-header">
                <h2>recent activity</h2>
                <a class="btn-ghost" href="/events" title="events excludes routine stage changes — see a task's own detail page for its full history">view events</a>
            </div>
            @if (recentEvents.Count == 0)
            {
                <p class="muted">nothing logged yet.</p>
            }
            else
            {
                <div class="live-timeline">
                    @foreach (var evt in recentEvents)
                    {
                        <div class="live-timeline-item" @key="evt.Id">
                            <span class="live-timeline-dot event-@(evt.Type.ToString().ToLowerInvariant())"></span>
                            <div class="live-timeline-content">
                                <div class="live-timeline-header">
                                    <span class="live-timeline-type">@FormatEventType(evt.Type)</span>
                                    <span class="live-timeline-time">@RelativeTime(evt.CreatedAt)</span>
                                </div>
                                <span class="live-timeline-summary">@evt.Summary</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private List<WorkTask>? tasks;
    private List<DashboardEvent> recentEvents = new();
    private int todayActivityCount;
    private bool connectionError;
    private Timer? refreshTimer;

    private List<WorkTask> Blocked =>
        (tasks ?? new()).Where(t => t.Stage == PipelineStage.BlockedOnHuman).OrderByDescending(t => t.UpdatedAt).ToList();

    private List<WorkTask> InProgress =>
        (tasks ?? new()).Where(t => t.Stage is not null && t.Stage != PipelineStage.BlockedOnHuman).OrderByDescending(t => t.UpdatedAt).ToList();

    protected override async Task OnInitializedAsync()
    {
        await Load();
        refreshTimer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await Load();
            StateHasChanged();
        }), null, 4000, 4000);
    }

    private async Task Load()
    {
        try
        {
            tasks = await Db.GetAllTasksAsync();
            var allEvents = await Db.GetEventsAsync();
            recentEvents = allEvents.Take(5).ToList();
            todayActivityCount = allEvents.Count(e => e.CreatedAt >= DateTime.UtcNow.AddHours(-24));
            connectionError = false;
        }
        catch (MongoException)
        {
            connectionError = true;
        }
    }

    private static string FormatStage(PipelineStage s) => s switch
    {
        PipelineStage.Queued => "queued",
        PipelineStage.SyncingToAzure => "syncing to azure",
        PipelineStage.Coding => "coding",
        PipelineStage.CodeReview => "code review",
        PipelineStage.Testing => "testing",
        PipelineStage.PushingBranch => "pushing branch",
        PipelineStage.AwaitingPrReview => "awaiting pr review",
        PipelineStage.FixingReviewComments => "fixing review comments",
        PipelineStage.Merging => "merging",
        PipelineStage.Closing => "closing",
        PipelineStage.BlockedOnHuman => "blocked on you",
        _ => s.ToString()
    };

    private static string FormatEventType(EventType t) => t switch
    {
        EventType.TaskCreated => "task created",
        EventType.TaskUpdated => "task updated",
        EventType.TaskAssigned => "task assigned",
        EventType.TaskReassigned => "task reassigned",
        EventType.TaskCommentAdded => "task comment",
        EventType.PrCreated => "pr created",
        EventType.PrUpdated => "pr updated",
        EventType.PrCommentAdded => "pr comment",
        EventType.PrApproved => "pr approved",
        EventType.TaskStageChanged => "stage changed",
        _ => t.ToString()
    };

    private static string RelativeTime(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d");
    }

    public void Dispose() => refreshTimer?.Dispose();
}
