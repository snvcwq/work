<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>dashboard</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='24' y2='24' gradientUnits='userSpaceOnUse'%3E%3Cstop stop-color='%2334d399'/%3E%3Cstop offset='1' stop-color='%2310b981'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='24' height='24' rx='6' fill='url(%23g)'/%3E%3Ccircle cx='7' cy='16.5' r='2' fill='%2304140e'/%3E%3Ccircle cx='12.5' cy='11' r='2.6' fill='%2304140e'/%3E%3Ccircle cx='18' cy='6.5' r='1.6' fill='%2304140e' opacity='0.9'/%3E%3C/svg%3E" />
    <!--
        Inline and synchronous on purpose: this has to run before first paint or the page
        flashes the wrong theme for a frame. A colocated .razor.js module loads as an async
        dynamic import well after Blazor initializes — too late to prevent the flash. Reading
        localStorage here is also why the toggle is plain DOM/JS rather than a Blazor
        @onclick — a theme switch should be instant, not wait on a SignalR round trip.
    -->
    <script>
        (function () {
            var theme = localStorage.getItem('dashboard-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);

            document.addEventListener('click', function (e) {
                var btn = e.target.closest('#theme-toggle');
                if (!btn) return;
                var current = document.documentElement.getAttribute('data-theme') || 'dark';
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('dashboard-theme', next);
            });

            // Per-tab accent (brand mark, reconnect modal, favicon) — mirrors the accent
            // vars in app.css by hand, since a favicon href can't read a CSS variable.
            // Run synchronously here so a direct load of e.g. /standup never flashes the
            // tasks (emerald) favicon; MainLayout re-runs window.dashboardApplyPage after
            // every later in-app navigation, since Blazor Server routes without a reload.
            var ACCENTS = {
                tasks: ['34d399', '10b981'],
                prs: ['60a5fa', '3b82f6'],
                events: ['fbbf24', 'f59e0b'],
                standup: ['a78bfa', '8b5cf6'],
                live: ['22d3ee', '06b6d4']
            };

            function pageKeyFromPath(pathname) {
                if (pathname.indexOf('/prs') === 0) return 'prs';
                if (pathname.indexOf('/events') === 0) return 'events';
                if (pathname.indexOf('/standup') === 0) return 'standup';
                if (pathname.indexOf('/live') === 0) return 'live';
                return 'tasks';
            }

            function faviconDataUri(a, b) {
                var svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'>" +
                    "<defs><linearGradient id='g' x1='0' y1='0' x2='24' y2='24' gradientUnits='userSpaceOnUse'>" +
                    "<stop stop-color='#" + a + "'/><stop offset='1' stop-color='#" + b + "'/></linearGradient></defs>" +
                    "<rect width='24' height='24' rx='6' fill='url(#g)'/>" +
                    "<circle cx='7' cy='16.5' r='2' fill='#04140e'/>" +
                    "<circle cx='12.5' cy='11' r='2.6' fill='#04140e'/>" +
                    "<circle cx='18' cy='6.5' r='1.6' fill='#04140e' opacity='0.9'/></svg>";
                return "data:image/svg+xml," + encodeURIComponent(svg);
            }

            window.dashboardApplyPage = function () {
                var key = pageKeyFromPath(location.pathname);
                document.documentElement.setAttribute('data-page', key);
                var pair = ACCENTS[key] || ACCENTS.tasks;
                var link = document.querySelector('link[rel="icon"]');
                if (link) link.href = faviconDataUri(pair[0], pair[1]);
            };
            window.dashboardApplyPage();
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["dashboard.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
